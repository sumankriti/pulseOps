{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "mfe-shell": {
      "projectType": "application",
      "root": "mfe-shell",
      "sourceRoot": "mfe-shell/src",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation-v4:build",
          "options": {
            "projectName": "mfe-shell",
            "tsConfig": "mfe-shell/tsconfig.federation.json",
            "cacheExternalArtifacts": true,
            "entryPoints": ["mfe-shell/src/main.ts"]
          },
          "configurations": {
            "production": {
              "target": "mfe-shell:esbuild:production"
            },
            "development": {
              "target": "mfe-shell:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation-v4:build",
          "options": {
            "projectName": "mfe-shell",
            "tsConfig": "mfe-shell/tsconfig.federation.json",
            "cacheExternalArtifacts": true,
            "entryPoints": ["mfe-shell/src/main.ts"],
            "target": "mfe-shell:serve-original:development",
            "rebuildDelay": 500,
            "dev": true,
            "devServer": true,
            "port": 4200
          }
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/mfe-shell",
            "browser": "mfe-shell/src/main.ts",
            "index": "mfe-shell/src/index.html",
            "tsConfig": "mfe-shell/tsconfig.app.json",
            "styles": ["shared/styles.css"],
            "polyfills": ["es-module-shims"],
            "assets": [
              {
                "glob": "**/*",
                "input": "mfe-shell/public",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "mfe-shell:esbuild:development"
            },
            "production": {
              "buildTarget": "mfe-shell:esbuild:production"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "host": "127.0.0.1",
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["mfe-shell/src/**/*.ts", "mfe-shell/src/**/*.html"],
            "maxWarnings": 0
          }
        }
      }
    },
