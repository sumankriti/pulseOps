{
  "name": "pulseops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve mfe-shell",
    "start:shell": "ng serve mfe-shell",
    "build": "npm run build:shell && npm run build:orders && npm run build:inventory",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs": "python3 scripts/render-guide.py",
    "test": "node --experimental-strip-types --test mfe-orders/src/app/order-rules.test.ts mfe-shell/src/app/auth/return-url.test.ts scripts/stores.test.mjs",
    "start:orders": "ng serve mfe-orders",
    "start:inventory": "ng serve mfe-inventory",
    "build:shell": "ng build mfe-shell",
    "build:orders": "ng build mfe-orders",
    "build:inventory": "ng build mfe-inventory",
    "test:e2e": "playwright test",
    "start:all": "node scripts/start-all.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "c8 npm test && node scripts/coverage-check.mjs",
    "sonar:scan": "node scripts/sonar-scan.mjs",
    "quality": "npm run lint && npm run typecheck && npm run format:check && npm run check:boundaries && npm run test:coverage",
    "verify": "npm run quality && npm run build && npm run test:e2e",
    "typecheck": "tsc --project tsconfig.eslint.json --noEmit"
  },
  "dependencies": {
    "@angular-architects/native-federation-v4": "21.2.18",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/localize": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@softarc/native-federation": "4.10.0",
    "es-module-shims": "2.8.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@sonar/scan": "5.0.0",
    "@types/node": "24.19.2",
    "angular-eslint": "21.4.0",
    "c8": "12.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": {
    "node": "^24.14.0"
  }
}
